      <pou name="SLM_INIT" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="INIT"><type><BOOL/></type></variable>
          </inputVars>
          <outputVars>
            <variable name="SUCCESS"><type><BOOL/></type></variable>
          </outputVars>
        </interface>
        <body>
          <ST>
            <xhtml:p><![CDATA[SUCCESS := 0;]]></xhtml:p>
          </ST>
        </body>
        <documentation>
          <xhtml:p><![CDATA[Initialize SL Modules and return the number of initialized modules on SUCCESS. If SUCCESS is zero, an error has occurred, or there aren't any modules on the bus]]></xhtml:p>
        </documentation>
      </pou>

